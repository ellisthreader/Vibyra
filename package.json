{
  "name": "vibyra",
  "version": "0.1.0",
  "description": "Vibyra AI mobile app, backend and website",
  "author": "Vibyra",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npm run dev",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "mobile:lines": "node scripts/check-source-lines.mjs --scope scripts/source-scopes/mobile.json",
    "test:mobile": "node scripts/run-mobile-tests.mjs",
    "check:mobile": "npm run mobile:lines && npm run typecheck && npm run test:mobile",
    "backend": "./scripts/start-backend.sh",
    "website": "node scripts/serve-website.mjs",
    "dev": "./scripts/start-dev.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-iap": "^4.2.3",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
