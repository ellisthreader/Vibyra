.DS_Store

# Obsidian vault local state. Keep notes, ignore app/workspace metadata.
Vibyra/.obsidian/
Vibyra/.trash/
Vibyra/_attachments/
Vibyra/_ai/Runs/
Vibyra/Prompt Transcripts.md
Vibyra/Productivity Stats.json

# Updater signing keys — the private key lives in ~/.tauri and in CI secrets,
# never in the repo. A leaked key lets anyone sign a "Vibyra update".
*.key
!desktop-tauri/src-tauri/tests/fixtures/*.sig

# Local probe/scaffolding that must never reach this public repo.
# The provider-audit crate at the root is a throwaway used to time CLI auth
# probes; fakebin holds stub executables for launch tests; the rest is build
# and installer output.
/Cargo.toml
/Cargo.lock
/src/main.rs
/rust-toolchain.toml
/fakebin/
/npm-installer/
/artifacts/
/Microsoft/
