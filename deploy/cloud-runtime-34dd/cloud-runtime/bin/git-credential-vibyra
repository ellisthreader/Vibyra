#!/usr/bin/env node
import { runHelper } from '../src/credential-helper.mjs';
let input = ''; process.stdin.setEncoding('utf8');
for await (const chunk of process.stdin) input += chunk;
try { process.stdout.write(await runHelper({ action: process.argv[2], input })); }
catch { process.stderr.write('vibyra: credential unavailable\n'); }
