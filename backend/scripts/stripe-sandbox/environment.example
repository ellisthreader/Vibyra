# Copy OUTSIDE the repository to the private disposable directory. No live values.
VIBYRA_STRIPE_SANDBOX=1
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8139
DB_CONNECTION=sqlite
DB_URL=
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=stderr
MEMBERSHIP_V2_ENABLED=true
MEMBERSHIP_STRIPE_ENABLED=true
MEMBERSHIP_STRIPE_ENVIRONMENT=test
MEMBERSHIP_NEW_ACCOUNTS_FROM=2026-01-01
MEMBERSHIP_FREE_ENABLED=false
MEMBERSHIP_APPLE_ENABLED=false
LEGAL_PAID_SALES_ENABLED=true
LEGAL_MARKET_ENFORCEMENT=false
LEGAL_SIGNUP_ENFORCEMENT=false
STRIPE_SUCCESS_URL=http://127.0.0.1:8139/billing/success
STRIPE_CANCEL_URL=http://127.0.0.1:8139/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://127.0.0.1:8139/account
# Fill privately from ONE Stripe sandbox. Runtime key mirrors production scopes.
STRIPE_SECRET_KEY=
STRIPE_SANDBOX_OPERATOR_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBERSHIP_PORTAL_CONFIGURATION=
STRIPE_MEMBERSHIP_PRO_MONTHLY=
STRIPE_MEMBERSHIP_PRO_ANNUAL=
STRIPE_MEMBERSHIP_TOKENS_80=
STRIPE_MEMBERSHIP_TOKENS_200=
STRIPE_MEMBERSHIP_TOKENS_450=
