# Copy the required values into the deployment's secret/configuration store.
# This example is not loaded automatically. Keep both flags off until acceptance.
VIBES_ENABLED=false
VIBES_PURCHASES_ENABLED=false
VIBES_DAILY_MICRO_USD_LIMIT=25000000
VIBES_QUEUE_CONNECTION=database
OPENROUTER_API_KEY=
VIBES_APPLE_ENVIRONMENT=Sandbox
APPLE_IAP_BUNDLE_ID=app.vibyra.mobile
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# Run a dedicated worker: php artisan queue:work database --queue=vibes --tries=1 --timeout=80
# Run the Laravel scheduler; recovery is minutely and Apple reconciliation hourly.
# Set the queue connection retry_after above the worker timeout (at least 120 seconds).
# Switch Apple environment to Production only with production transactions/products.
