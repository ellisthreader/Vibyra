{
  "name": "vibyra-desktop-tauri",
  "version": "0.1.10",
  "description": "Vibyra Desktop — AI terminal workspace (Tauri 2 + Rust + React + xterm.js)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lines": "node ../scripts/check-desktop-lines.mjs",
    "check:dead-code": "knip --include files,dependencies,exports,unlisted,unresolved",
    "tauri": "tauri",
    "app:dev": "node scripts/dev.mjs",
    "app:build": "npm run app:install",
    "app:build:linux": "tauri build --bundles appimage",
    "app:build:deb": "tauri build --bundles deb",
    "app:install": "node scripts/install-linux.mjs",
    "app:install:only": "node scripts/install-linux.mjs --no-build",
    "discord:configure": "bash scripts/configure-discord-webhook.sh configure",
    "discord:test": "bash scripts/configure-discord-webhook.sh test",
    "discord:clear": "bash scripts/configure-discord-webhook.sh clear",
    "app:build:windows": "tauri build --bundles nsis",
    "app:build:windows:cross": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "core:check": "cargo check --manifest-path src-tauri/crates/vibyra-core/Cargo.toml",
    "core:test": "cargo test --manifest-path src-tauri/crates/vibyra-core/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --locked",
    "rust:audit": "cargo audit --file src-tauri/Cargo.lock --ignore RUSTSEC-2024-0429",
    "verify": "npm run lines && npm run check:dead-code && npm test && npm run build && npm run rust:fmt && npm run rust:clippy && npm run rust:test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "knip": "6.32.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
