{
  "app": {
    "windows": [
      {
        "title": "Vibyra",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0e0f12",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ]
  },
  "bundle": {
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "targets": [
      "app"
    ]
  }
}
