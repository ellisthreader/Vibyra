{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibyra",
  "mainBinaryName": "Vibyra",
  "version": "0.2.5",
  "identifier": "app.vibyra.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vibyra",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0e0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://openrouter.ai; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; font-src 'self' data:; frame-src http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Vibyra AI terminal workspace",
    "longDescription": "Run and orchestrate multiple AI CLI agents (Claude Code, Codex, Gemini and more) in a fast native terminal grid.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NTE1QzlEMzQyNkQ0QUYKUldTdjFDWTBuVnhSV05kdFpOdDduaEx2OUJ0OXc3WGxPbUpoenBNc0hZd0ZTejhNVHhIa3Nkb3AK",
      "endpoints": [
        "https://vibyra-production.up.railway.app/web-api/updates/{{target}}/{{arch}}/{{bundle_type}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
