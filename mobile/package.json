{
  "name": "@vibyra/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export": "expo export --platform ios --platform web",
    "doctor": "npx expo-doctor",
    "assets": "node scripts/build-runtime.mjs",
    "check": "npm run assets && npm run typecheck && npm test && npm run lines",
    "prestart": "npm run assets",
    "preweb": "npm run assets",
    "preexport": "npm run assets",
    "lines": "node scripts/check-lines.mjs",
    "verify:terminal": "npm run assets && node scripts/verify-terminal.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:host-ui": "npm run assets && node scripts/verify-host-ui.mjs",
    "phone": "expo start --go --lan --port 8081",
    "prephone": "npm run assets"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "expo": "~57.0.17",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-secure-store": "~57.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2"
  }
}
