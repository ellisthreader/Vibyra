{
  "name": "@vibyra/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export": "expo export --platform ios --platform web",
    "doctor": "npx expo-doctor",
    "assets": "node scripts/build-runtime.mjs",
    "check": "npm run assets && npm run typecheck && npm test && npm run lines",
    "prestart": "npm run assets",
    "preweb": "npm run assets",
    "preexport": "npm run assets",
    "lines": "node scripts/check-lines.mjs",
    "verify:terminal": "npm run assets && node scripts/verify-terminal.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:conversation-ui": "node scripts/verify-conversation-ui.mjs",
    "verify:auth-ui": "node scripts/verify-auth-ui.mjs",
    "verify:host-ui": "npm run assets && node scripts/verify-host-ui.mjs",
    "phone": "expo start --dev-client --lan --port 8081",
    "prephone": "npm run assets",
    "verify:discovery": "node scripts/verify-discovery-ui.mjs",
    "verify:modes": "node scripts/verify-modes.mjs",
    "verify:integrations": "node scripts/verify-integrations-ui.mjs",
    "verify:settings": "node scripts/verify-settings-ui.mjs",
    "verify:settings-ai": "node scripts/verify-settings-ai.mjs",
    "verify:memory": "node scripts/verify-memory-ui.mjs",
    "verify:settings-account": "node scripts/verify-settings-account.mjs",
    "verify:two-factor": "node scripts/verify-two-factor.mjs",
    "verify:settings-states": "node scripts/verify-settings-states.mjs",
    "verify:vibes": "node scripts/verify-vibes-ui.mjs",
    "verify:wallet": "node scripts/verify-wallet-ui.mjs",
    "verify:nearby": "node scripts/verify-nearby-pairing.mjs",
    "verify:probe": "tsx scripts/verify-probe.ts",
    "verify:projects": "node scripts/verify-projects-ui.mjs",
    "verify:new-session": "node scripts/verify-new-session.mjs",
    "verify:new-project": "node scripts/verify-new-project.mjs",
    "verify:remote": "node scripts/verify-remote-ui.mjs",
    "verify:work-picker": "node scripts/verify-work-picker.mjs",
    "verify:vibes-models": "node scripts/verify-vibes-models.mjs",
    "icons": "node scripts/generate-model-icons.mjs",
    "verify:terminal-native": "node scripts/verify-terminal-native.mjs",
    "verify:terminal-input": "node scripts/verify-terminal-input.mjs",
    "verify:desktop-typing": "node scripts/verify-desktop-typing.mjs",
    "verify:desktop-terminal-native": "node scripts/verify-desktop-terminal-native.mjs",
    "verify:terminal-layout": "node scripts/verify-terminal-layout.mjs",
    "verify:reconnect": "npm run assets && node scripts/verify-reconnect.mjs",
    "phone:go": "expo start --go --lan --port 8081",
    "prephone:go": "npm run assets",
    "ios:device": "expo run:ios --device"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/xterm": "^5.5.0",
    "expo": "~57.0.17",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
