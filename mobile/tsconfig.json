{
  "extends": "expo/tsconfig.base",
  "compilerOptions": { "strict": true, "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true, "types": ["react", "node"] },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/generated"]
}
